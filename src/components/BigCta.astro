---
const BOOK_A_CALL_URL = 'https://cal.com/zainab-daodu/work-with-me';
---
<section class="big-cta" aria-labelledby="cta-heading">
  <div class="big-cta-inner">
    <h2 id="cta-heading" class="cta-title scroll-fade">
      Ready to fix your <em>documentation?</em>
    </h2>
    <p class="cta-sub scroll-fade">Whether you need a senior writer, a documentation strategy, or a consultant. Let's talk.</p>
    <div class="cta-buttons scroll-fade">
      <a href={BOOK_A_CALL_URL} class="btn-primary btn-cta" target="_blank" rel="noopener noreferrer">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        Book a Call
      </a>
      <a href="/work-with-me" class="btn-ghost">View Services</a>
    </div>
  </div>
</section>

<style>
  /* A deliberately dark, bold CTA band in both themes — matches CtaLeadBlock's
     left panel treatment rather than flipping with the page background. */
  .big-cta { background: #0d0716; padding: 5rem 1.75rem; text-align: center; border-top: 1px solid var(--purple-22); }
  .big-cta-inner { max-width: 560px; margin: 0 auto; }
  .cta-title { color: #FAFAFA; font-size: clamp(26px, 5vw, 44px); font-weight: 800; letter-spacing: -0.03em; margin-bottom: 0.85rem; line-height: 1.1; overflow-wrap: break-word; }
  .cta-title em { color: var(--color-purple); font-style: normal; }
  .cta-sub { color: rgba(250,250,250,0.65); font-size: clamp(16px, 2vw, 20px); line-height: 1.7; margin-bottom: 2rem; }
  .cta-buttons { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

  /* .btn-ghost is a shared utility (global.css) that normally uses the
     flipping ink/white text ladder — correct on a page background, but
     this panel stays dark always, so pin it to fixed light values here. */
  .cta-buttons :global(.btn-ghost) { color: rgba(250,250,250,0.65); border-color: rgba(250,250,250,0.22); }
  .cta-buttons :global(.btn-ghost:hover) { color: #FAFAFA; border-color: rgba(250,250,250,0.55); }
</style>
