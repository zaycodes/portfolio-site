---
// ScrollAnimations.astro
// Adds scroll-triggered fade-in animations to sections and cards
// Include this once in BaseLayout.astro
---

<style is:global>
  /* Scroll animation base states */
  .scroll-fade {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }

  .scroll-fade.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Stagger delays for children */
  .stagger-children > *:nth-child(1) { transition-delay: 0s; }
  .stagger-children > *:nth-child(2) { transition-delay: 0.08s; }
  .stagger-children > *:nth-child(3) { transition-delay: 0.16s; }
  .stagger-children > *:nth-child(4) { transition-delay: 0.24s; }
  .stagger-children > *:nth-child(5) { transition-delay: 0.32s; }
  .stagger-children > *:nth-child(6) { transition-delay: 0.40s; }
  .stagger-children > *:nth-child(7) { transition-delay: 0.48s; }
  .stagger-children > *:nth-child(8) { transition-delay: 0.56s; }
  .stagger-children > *:nth-child(9) { transition-delay: 0.64s; }

  /* Slide in from left */
  .scroll-slide-left {
    opacity: 0;
    transform: translateX(-28px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .scroll-slide-left.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  /* Scale in */
  .scroll-scale {
    opacity: 0;
    transform: scale(0.94);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .scroll-scale.is-visible {
    opacity: 1;
    transform: scale(1);
  }
</style>

<script>
  // Observe all scroll-animated elements
  const animClasses = ['.scroll-fade', '.scroll-slide-left', '.scroll-scale'];

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');

          // If this is a stagger parent, also animate its children
          if (entry.target.classList.contains('stagger-children')) {
            entry.target.querySelectorAll(':scope > *').forEach(child => {
              child.classList.add('scroll-fade');
            });
            // Re-observe children after a tick so they pick up the class
            requestAnimationFrame(() => {
              entry.target.querySelectorAll(':scope > .scroll-fade:not(.is-visible)').forEach(child => {
                child.classList.add('is-visible');
              });
            });
          }

          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
  );

  // Observe all targets on load and after any dynamic content
  function observeAll() {
    animClasses.forEach(cls => {
      document.querySelectorAll(cls).forEach(el => {
        if (!el.classList.contains('is-visible')) {
          observer.observe(el);
        }
      });
    });
  }

  observeAll();

  // Re-run after Astro view transitions if used
  document.addEventListener('astro:page-load', observeAll);
</script>
