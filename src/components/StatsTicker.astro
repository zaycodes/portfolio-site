---
import { stats } from '../data/work';
---

<section class="impact" id="impact-section" aria-labelledby="impact-heading">
  <!-- Decorative geometric shapes — purely visual -->
  <span class="deco deco-ring-lg" aria-hidden="true"></span>
  <span class="deco deco-ring-sm" aria-hidden="true"></span>
  <span class="deco deco-diamond" aria-hidden="true"></span>
  <span class="deco deco-dot-cluster" aria-hidden="true"></span>

  <div class="impact-inner">
    <div class="impact-head">
      <div class="impact-label-row">
        <span class="impact-bar" aria-hidden="true"></span>
        <p class="impact-eyebrow" id="impact-heading">Impact</p>
        <span class="impact-rule" aria-hidden="true"></span>
      </div>
      <p class="impact-headline">Where the work speaks for itself.</p>
    </div>

    <div class="impact-grid" role="list">
      {stats.map((stat, i) => (
        <div class="impact-item" role="listitem">
          <span
            class:list={['impact-num', i % 2 === 0 ? 'num-dark' : 'num-purple']}
            data-target={stat.value}
          >
            {stat.value}
          </span>
          <span class="impact-line" aria-hidden="true"></span>
          <span class="impact-label">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function parseVal(value: string): { num: number; suffix: string } {
    const m = value.match(/^(\d+)(.*)$/);
    return m ? { num: parseInt(m[1]), suffix: m[2] } : { num: 0, suffix: value };
  }

  function countUp(el: Element, target: number, suffix: string, duration: number) {
    const start = performance.now();
    function update(now: number) {
      const t = Math.min((now - start) / duration, 1);
      const ease = 1 - Math.pow(1 - t, 3);
      el.textContent = Math.floor(ease * target) + suffix;
      if (t < 1) requestAnimationFrame(update);
      else el.textContent = target + suffix;
    }
    requestAnimationFrame(update);
  }

  const section = document.getElementById('impact-section');
  const nums = document.querySelectorAll<HTMLElement>('.impact-num[data-target]');
  let animated = false;

  const observer = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting && !animated) {
      animated = true;
      nums.forEach((el, i) => {
        const raw = el.getAttribute('data-target') ?? '';
        const { num, suffix } = parseVal(raw);
        setTimeout(() => countUp(el, num, suffix, 1800), i * 150);
      });
      observer.disconnect();
    }
  }, { threshold: 0.25 });

  if (section) observer.observe(section);
</script>

<style>
  .impact {
    background: var(--surface-indigo);
    /* V-shape top → diagonal slant bottom (different shape each end) */
    clip-path: polygon(
      0 48px,
      50% 0,
      100% 48px,
      100% 100%,
      0 calc(100% - 48px)
    );
    margin-top: -48px;
    padding: calc(5.5rem + 48px) 1.75rem calc(5rem + 48px);
    position: relative;
    z-index: 2;
    overflow: hidden;
    /* Subtle dot-grid texture on the section bg */
    background-image:
      url("data:image/svg+xml,%3Csvg width='28' height='28' viewBox='0 0 28 28' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='2' cy='2' r='1.2' fill='rgba(132%2C12%2C214%2C0.14)'/%3E%3C/svg%3E");
    background-size: 28px 28px;
    background-color: var(--surface-indigo);
  }

  /* Soft radial wash — keeps centre balanced */
  .impact::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 60% at 50% 50%, var(--surface-indigo) 30%, transparent 100%),
      radial-gradient(ellipse 40% 50% at 80% 20%, rgba(132,12,214,0.1) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .impact-inner {
    max-width: 1140px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  /* ── Decorative shapes ── */
  .deco { position: absolute; pointer-events: none; }

  /* Large outer ring — top-right, bleeds outside */
  .deco-ring-lg {
    width: 380px; height: 380px;
    border-radius: 50%;
    border: 1px solid rgba(132,12,214,0.1);
    top: -100px; right: -100px;
  }
  /* Inner ring nested inside the large one */
  .deco-ring-lg::after {
    content: '';
    position: absolute;
    inset: 50px;
    border-radius: 50%;
    border: 1px solid rgba(132,12,214,0.06);
  }

  /* Medium ring — bottom-left */
  .deco-ring-sm {
    width: 200px; height: 200px;
    border-radius: 50%;
    border: 1px solid rgba(132,12,214,0.09);
    bottom: 40px; left: -60px;
  }

  /* Rotated square / diamond — mid-right area */
  .deco-diamond {
    width: 36px; height: 36px;
    border: 1.5px solid rgba(132,12,214,0.22);
    transform: rotate(45deg);
    top: 38%; right: 12%;
  }

  /* Tight cluster of four small dots — bottom-right quadrant */
  .deco-dot-cluster {
    width: 56px; height: 56px;
    background-image: radial-gradient(circle, rgba(132,12,214,0.2) 1.5px, transparent 1.5px);
    background-size: 16px 16px;
    bottom: 28%; right: 22%;
  }

  /* ── Header ── */
  .impact-head { margin-bottom: 5rem; }

  .impact-label-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 1rem;
  }

  .impact-bar {
    display: block;
    width: 3px; height: 16px;
    background: var(--color-purple);
    border-radius: 2px;
    flex-shrink: 0;
  }

  .impact-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-purple);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .impact-rule {
    flex: 1;
    height: 1px;
    background: rgba(132,12,214,0.18);
  }

  .impact-headline {
    font-size: clamp(22px, 3.5vw, 34px);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--color-white);
    line-height: 1.1;
  }

  /* ── 3-col grid, no boxes ── */
  .impact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4.5rem 3rem;
  }

  .impact-item { display: flex; flex-direction: column; }

  .impact-num {
    font-size: clamp(48px, 6vw, 72px);
    font-weight: 900;
    letter-spacing: -0.04em;
    line-height: 1;
    display: block;
    margin-bottom: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .num-dark   { color: var(--color-white); }
  .num-purple { color: var(--color-purple); }

  .impact-line {
    display: block;
    width: 28px;
    height: 2px;
    background: var(--color-purple);
    border-radius: 1px;
    margin-bottom: 0.85rem;
    opacity: 0.55;
  }

  .impact-label {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--white-55);
    line-height: 1.6;
    letter-spacing: 0.01em;
    max-width: 18ch;
  }

  @media (max-width: 600px) {
    .impact {
      clip-path: polygon(0 36px, 50% 0, 100% 36px, 100% 100%, 0 calc(100% - 36px));
      margin-top: -36px;
      padding: calc(3.5rem + 36px) 1.75rem calc(3.5rem + 36px);
    }
    .impact-head { margin-bottom: 3rem; }
    .impact-grid { grid-template-columns: repeat(2, 1fr); gap: 3rem 2rem; }
    /* The 48px floor below was sized for a single-row layout — in this
       2-column mobile grid it's wide enough to clip values like "88%"
       and "600" past the edge of the column. */
    .impact-num { font-size: clamp(30px, 10vw, 42px); }
    .deco-ring-lg { width: 220px; height: 220px; top: -60px; right: -60px; }
    .deco-ring-sm { width: 120px; height: 120px; }
    .deco-diamond { display: none; }
    .deco-dot-cluster { display: none; }
  }
</style>
