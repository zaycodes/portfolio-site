---
const BOOK_A_CALL_URL = 'https://cal.com/zainab-daodu/work-with-me';
---
<section class="ctb" aria-label="Connect and resources">

  <!-- Left: Book a call — soft pale-purple panel in dark theme (swapped with the right panel's light-mode shade, so the vivid-purple button pops against it instead of blending in), near-black in light theme -->
  <div class="ctb-left">
    <div class="ctb-inner">
      <h2 class="ctb-title">
        Let's build better <em>documentation.</em>
      </h2>
      <p class="ctb-sub">
        Whether you're scaling a docs team, starting from scratch, or trying to make your documentation easier to maintain, I'd love to help.
      </p>
      <div class="ctb-btns">
        <a href={BOOK_A_CALL_URL} class="btn-primary btn-cta" target="_blank" rel="noopener noreferrer">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Book a Call
        </a>
        <a href="/work-with-me" class="ctb-ghost">View Services</a>
      </div>
    </div>
  </div>

  <!-- Right: Free resource — near-black in dark theme, pale lavender in light theme (always blends toward the page) -->
  <div class="ctb-right">
    <span class="ctb-tag">Free Resource</span>
    <div class="ctb-inner">
      <h2 class="ctb-title">
        The <em>AI Documentation Pipeline</em>
      </h2>
      <p class="ctb-sub">
        A practical guide to building documentation workflows with automated checks, linting, and AI-assisted review.
      </p>
      <form
        name="ai-doc-pipeline-footer"
        method="POST"
        action="/api/subscribe"
        class="ctb-form"
        aria-label="Download the AI Documentation Pipeline"
      >
        <input type="hidden" name="resource" value="ai-doc-pipeline" />
        <input type="hidden" name="bot-field" />
        <div class="ctb-form-row ctb-input--name">
          <label for="ctb-first-name" class="sr-only">First name</label>
          <input id="ctb-first-name" type="text" name="firstName" placeholder="First name" required autocomplete="given-name" class="ctb-input" />
          <label for="ctb-last-name" class="sr-only">Last name</label>
          <input id="ctb-last-name" type="text" name="lastName" placeholder="Last name" required autocomplete="family-name" class="ctb-input" />
        </div>
        <div class="ctb-form-row">
          <label for="ctb-email" class="sr-only">Your email address</label>
          <input id="ctb-email" type="email" name="email" placeholder="your@email.com" required autocomplete="email" class="ctb-input" />
          <button type="submit" class="ctb-submit">Download →</button>
        </div>
      </form>
    </div>
  </div>

</section>

<style>
  /* ── Container — no background so neither panel bleeds ── */
  .ctb {
    display: flex;
    overflow: hidden;
  }

  /* ── Left panel — the primary CTA (Book a Call). In dark theme it's the
     same soft pale-purple shade as the right panel's light-theme background
     (swapped roles), so the vivid-purple button sitting on top of it actually
     stands out instead of matching its own panel. In light theme it's back
     to near-black, contrasting against the page's pale background. ── */
  .ctb-left {
    flex: 0 0 calc(50% + 16px);
    background: #E6D2F7;
    clip-path: polygon(0 0, 100% 0, calc(100% - 32px) 100%, 0 100%);
    border-top: 1px solid var(--purple-22);
    padding: 4rem 3rem;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    position: relative;
    z-index: 1;
  }
  :global(html[data-theme="light"]) .ctb-left { background: #0d0716; }

  /* ── Right panel — the free resource. Always the panel that blends
     toward the page's own background, so it reads as secondary next to
     the left panel's contrast-forward CTA. ── */
  .ctb-right {
    flex: 1;
    background: #0d0716;
    border-top: 1px solid rgba(132,12,214,0.2);
    padding: 4rem 2.5rem 4rem 3.5rem;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    position: relative;
  }
  :global(html[data-theme="light"]) .ctb-right { background: var(--surface-banner); }

  /* Fills the triangular clip gap between the two panels */
  .ctb-right::before {
    content: '';
    position: absolute;
    top: 0;
    left: -32px;
    width: 32px;
    height: 100%;
    background: #0d0716;
    pointer-events: none;
  }
  :global(html[data-theme="light"]) .ctb-right::before { background: var(--surface-banner); }

  /* "Free Resource" badge — corner, out of flow. Light text by default
     (right panel is dark), dark ink once the right panel goes light. */
  .ctb-tag {
    position: absolute;
    top: 1.1rem;
    right: 1.5rem;
    background: rgba(132,12,214,0.15);
    border: 1px solid rgba(132,12,214,0.3);
    border-radius: 100px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.9);
    padding: 4px 12px;
  }
  :global(html[data-theme="light"]) .ctb-tag { color: var(--banner-ink-2); }

  /* Shared inner content — top-aligned, matching width */
  .ctb-inner {
    max-width: 400px;
    width: 100%;
    text-align: center;
  }

  /* ── Title ── */
  .ctb-title {
    font-size: clamp(22px, 3.2vw, 36px);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 0.85rem;
    color: var(--color-white);
  }
  .ctb-title em { color: var(--color-purple); font-style: normal; }

  /* Dark theme: the left panel is now pale lavender, so its text is forced
     to dark ink — the base tokens would otherwise flip to light ink here. */
  .ctb-left .ctb-title { color: var(--banner-ink); }
  .ctb-left .ctb-title em { color: var(--color-purple); }
  .ctb-left .ctb-sub { color: rgba(26,14,46,0.65); }
  .ctb-left ::selection { background: rgba(132,12,214,0.2); color: var(--banner-ink); }

  /* Light theme: the left panel goes back to near-black, so its text goes
     back to forced light ink. */
  :global(html[data-theme="light"]) .ctb-left .ctb-title { color: #FAFAFA; }
  :global(html[data-theme="light"]) .ctb-left .ctb-title em { color: #bf7fff; }
  :global(html[data-theme="light"]) .ctb-left .ctb-sub { color: rgba(250,250,250,0.65); }
  :global(html[data-theme="light"]) .ctb-left ::selection { background: rgba(255, 255, 255, 0.25); color: #FAFAFA; }

  /* ── Sub text ── */
  .ctb-sub {
    color: var(--white-55);
    font-size: 15px;
    line-height: 1.75;
    margin-bottom: 2rem;
  }

  /* ── Left buttons ── */
  .ctb-btns { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }

  .ctb-ghost {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    padding: 14px 24px;
    border-radius: var(--radius-sm);
    border: 1px solid rgba(26,14,46,0.2);
    color: rgba(26,14,46,0.75);
    text-decoration: none;
    white-space: nowrap;
    transition: border-color 0.2s, color 0.2s;
  }
  .ctb-ghost:hover { border-color: rgba(26,14,46,0.55); color: var(--banner-ink); }
  :global(html[data-theme="light"]) .ctb-ghost { border-color: rgba(255,255,255,0.2); color: rgba(255,255,255,0.75); }
  :global(html[data-theme="light"]) .ctb-ghost:hover { border-color: rgba(255,255,255,0.55); color: #fff; }

  /* ── Right form ── */
  .ctb-form { display: flex; flex-direction: column; align-items: center; }
  .ctb-form-row { display: flex; gap: 8px; width: 100%; max-width: 360px; }
  .ctb-input--name { width: 100%; max-width: 360px; margin-bottom: 8px; }

  .ctb-input {
    flex: 1;
    min-width: 0;
    background: rgba(255,255,255,0.3);
    border: 1px solid rgba(26,14,46,0.25);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: #1a0e2e;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .ctb-input::placeholder { color: rgba(26,14,46,0.45); }
  .ctb-input:focus { border-color: var(--color-purple); box-shadow: 0 0 0 2px rgba(132,12,214,0.15); }

  .ctb-submit {
    background: var(--color-purple);
    color: #fff;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 700;
    padding: 12px 18px;
    border-radius: var(--radius-sm);
    border: none;
    cursor: pointer;
    white-space: nowrap;
    flex-shrink: 0;
    transition: opacity 0.2s;
  }
  .ctb-submit:hover { opacity: 0.85; }

  /* ── Responsive ── */
  @media (max-width: 1000px) {
    .ctb { flex-direction: column; }
    .ctb-left { flex: none; clip-path: none; padding: 3.5rem 1.75rem; align-items: center; }
    .ctb-right {
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      padding: 2rem 1.75rem 3.5rem;
    }
    .ctb-right::before { display: none; }
    .ctb-tag {
      position: static;
      display: inline-block;
      margin-bottom: 1.25rem;
      align-self: center;
    }
    .ctb-right .ctb-inner { text-align: center; }
  }
  @media (max-width: 480px) {
    .ctb-form-row { flex-direction: column; }
    .ctb-submit { width: 100%; }
  }

  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; }
</style>
