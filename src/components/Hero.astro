---
// Hero.astro — photo beside all content; 2-column layout throughout
---
<section class="hero" aria-label="Introduction">
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="orb orb-1" aria-hidden="true"></div>
  <div class="orb orb-2" aria-hidden="true"></div>
  <div class="hero-content">

    <div class="hero-left">
      <div class="hero-badge">
        <span class="badge-dot" aria-hidden="true"></span>
        <span>Contract · Consulting · Mentorship · Speaking</span>
      </div>
      <h1 class="hero-headline">
        <span class="reveal-wrap"><span class="hero-name">Hi, I'm Zainab Daodu.</span></span>
        <span class="reveal-wrap"><span class="hl hl1">Before I documented the code,</span></span>
        <span class="reveal-wrap"><span class="hl hl2">I wrote it.</span></span>
      </h1>
      <p class="hero-sub">
        A decade later, I own the full documentation stack.
        <strong>API references, product guides, UX copy, and the AI-assisted pipelines that ship them.</strong>
      </p>

      <div class="hero-btns">
        <a href="/work" class="btn-primary">View My Work</a>
        <a href="/about" class="btn-ghost">Read My Story →</a>
      </div>
    </div>

    <div class="hero-photo-wrap">
      <div class="hero-photo-frame">
        <img src="/images/zainab-daodu.jpg" alt="Zainab Daodu speaking at Open Source Summit" class="hero-photo" loading="eager" />
        <div class="hero-photo-overlay" aria-hidden="true"></div>
      </div>
    </div>

    <div class="hero-bottom">
        <div class="impact-grid" aria-label="Key achievements">
          <div class="impact-col">
            <span class="impact-stat">Sole writer</span>
            <span class="impact-text">Designed and maintained documentation ecosystems covering <strong> 300+ API endpoints across 20 product areas.</strong></span>
          </div>
          <div class="impact-col">
            <span class="impact-stat">Built to outlast</span>
            <span class="impact-text"><strong>AI pipeline, linting, and CI/CD,</strong> documentation workflows that keep running, even when I’m not.</span>
          </div>
          <div class="impact-col">
            <span class="impact-stat">Full stack</span>
            <span class="impact-text">I own the full documentation journey from<strong> API docs, product docs, and UX copy,</strong> to the operations that tie them together.</span>
          </div>
        </div>
      </div>

  </div>
</section>

<style>
  .hero { background: var(--color-black); padding: 1.5rem 0 7.5rem; position: relative; overflow: hidden; }
  .hero-grid { position: absolute; inset: 0; background-image: url("data:image/svg+xml,%3Csvg width='48' height='48' viewBox='0 0 48 48' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M48 0H0V48' stroke='rgba(132,12,214,0.07)' stroke-width='.5' fill='none'/%3E%3C/svg%3E"); background-size: 48px 48px; animation: gridScroll 24s linear infinite; pointer-events: none; }
  .orb { position: absolute; border-radius: 50%; pointer-events: none; }
  .orb-1 { width: 420px; height: 420px; background: rgba(132,12,214,0.07); top: -120px; left: -120px; animation: orbPulse 7s ease-in-out infinite; }
  .orb-2 { width: 220px; height: 220px; background: rgba(132,12,214,0.04); bottom: 60px; right: 300px; animation: orbPulse 9s ease-in-out 2s infinite; }

  .hero-content { position: relative; z-index: 1; max-width: 1140px; margin: 0 auto; padding: 0 1.75rem; display: grid; grid-template-columns: 1fr 300px; grid-template-rows: auto auto; column-gap: 2.5rem; }
  .hero-left { grid-column: 1; grid-row: 1; min-width: 0; }

  /* Photo — only in row 1, col 2 */
  .hero-photo-wrap { grid-column: 2; grid-row: 1; display: flex; justify-content: flex-end; position: relative; align-self: start; }
  .hero-photo-wrap::before {
    content: '';
    position: absolute;
    inset: -20px;
    background: linear-gradient(148deg,
      transparent 25%,
      rgba(132,12,214,0.1) 52%,
      rgba(132,12,214,0.05) 68%,
      transparent 82%
    );
    z-index: 0;
    pointer-events: none;
  }
  .hero-photo-frame {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 420px;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 24px 60px rgba(132,12,214,0.25), 0 10px 30px rgba(0,0,0,0.65);
    border: 1px solid rgba(132,12,214,0.2);
  }
  .hero-photo {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center top;
  }
  .hero-photo-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, transparent 50%, rgba(5,0,15,0.72) 100%),
      linear-gradient(to right, rgba(132,12,214,0.14) 0%, transparent 55%);
    z-index: 2;
    pointer-events: none;
    border-radius: 12px;
  }

  /* Badge */
  .hero-badge { display: inline-flex; align-items: center; gap: 8px; background: rgba(132,12,214,0.07); border: 1px solid rgba(132,12,214,0.3); border-radius: var(--radius-sm); padding: 6px 14px; margin-bottom: 1.25rem; animation: fadeUp 0.4s ease both; }
  .badge-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--color-purple); animation: blink 2s ease infinite; flex-shrink: 0; }
  .hero-badge span:last-child { color: var(--color-purple); font-size: 12px; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; }

  /* Headline */
  .hero-headline { margin-bottom: 1.25rem; }
  .reveal-wrap { overflow: hidden; display: block; }
  .hero-name { display: block; font-family: var(--font-mono); font-size: clamp(15px, 2vw, 20px); font-weight: 400; color: var(--white-55); letter-spacing: 0.02em; animation: slideReveal 0.65s cubic-bezier(0.16,1,0.3,1) 0.1s both; }
  .hl { display: block; font-weight: 800; letter-spacing: -0.03em; line-height: 1.02; animation: slideReveal 0.7s cubic-bezier(0.16,1,0.3,1) both; }
  .hl1 { font-size: clamp(28px, 5vw, 52px); color: var(--color-white); animation-delay: 0.22s; }
  .hl2 { font-size: clamp(28px, 5vw, 52px); color: var(--color-purple); animation-delay: 0.4s; }
  @keyframes slideReveal { from { transform: translateY(108%); } to { transform: translateY(0); } }

  /* Sub */
  .hero-sub { color: var(--white-55); font-size: clamp(15px, 2vw, 18px); line-height: 1.8; animation: fadeUp 0.5s ease 0.5s both; opacity: 0; }
  .hero-sub strong { color: var(--white-85); font-weight: 600; }

  /* Buttons — inline beside photo */
  .hero-btns { display: flex; gap: 14px; flex-wrap: wrap; margin-top: 2rem; animation: fadeUp 0.5s ease 0.65s both; opacity: 0; }

  /* Bottom — full width row below photo */
  .hero-bottom { grid-column: 1 / -1; grid-row: 2; animation: fadeUp 0.5s ease 0.65s both; opacity: 0; padding-top: 2.5rem; }
  .btn-primary, .btn-ghost { font-size: 15px !important; padding: 14px 28px !important; }

  /* Impact grid */
  .impact-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; background: rgba(132,12,214,0.2); border: 1px solid rgba(132,12,214,0.2); border-radius: 8px; overflow: hidden; }
  .impact-col { background: rgba(8,8,8,0.95); padding: 1.5rem 1.75rem; display: flex; flex-direction: column; gap: 0.65rem; transition: background 0.25s; }
  .impact-col:hover { background: rgba(132,12,214,0.06); }
  :global(html[data-theme="light"]) .impact-col { background: rgba(255,255,255,0.7); }
  .impact-stat { font-family: var(--font-mono); font-size: 15px; font-weight: 700; color: var(--color-purple); display: block; letter-spacing: 0.02em; }
  .impact-text { font-size: 15px; color: var(--white-55); line-height: 1.65; }
  .impact-text strong { color: var(--white-85); font-weight: 600; }

  /* Responsive */
  @media (max-width: 1000px) { .hero-content { grid-template-columns: 1fr; } .hero-left { grid-column: 1; } .hero-bottom { grid-column: 1; } .hero-photo-wrap { display: none; } }
  @media (max-width: 700px) { .impact-grid { grid-template-columns: 1fr; } }
  /* On narrow phones the headline phrases wrap to two lines — the reveal
     animation's overflow:hidden clipping (sized for one line) would cut
     the wrapped second line off, so drop the clip on small screens. */
  @media (max-width: 480px) { .reveal-wrap { overflow: visible; } }

  @keyframes fadeUp { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes gridScroll { from { background-position: 0 0; } to { background-position: 48px 48px; } }
  @keyframes orbPulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.1) translate(-8px,8px); } }
  @keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }
</style>
