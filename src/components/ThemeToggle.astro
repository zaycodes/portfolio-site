---
// ThemeToggle.astro — sun/moon button that flips [data-theme] on <html> and
// persists the choice. Safe to render more than once per page (e.g. desktop
// nav + mobile menu); the script below wires up every instance and Astro
// dedupes the script itself across repeated usages of this component.
---
<button class="theme-toggle" type="button" aria-pressed="false" aria-label="Toggle color theme">
  <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
  </svg>
  <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    background: transparent;
    border: 1px solid var(--white-22);
    border-radius: var(--radius-sm);
    color: var(--white-55);
    cursor: pointer;
    transition: border-color var(--transition-base), color var(--transition-base);
  }
  .theme-toggle:hover {
    border-color: var(--color-purple);
    color: var(--color-purple);
  }

  /* Dark theme (default): show the sun — click to switch to light. */
  .icon-moon { display: none; }

  /* Light theme: show the moon — click to switch back to dark. */
  :global(html[data-theme="light"]) .icon-sun { display: none; }
  :global(html[data-theme="light"]) .icon-moon { display: block; }
</style>

<script>
  function syncButton(btn: Element) {
    const isLight = document.documentElement.dataset.theme === 'light';
    btn.setAttribute('aria-pressed', String(isLight));
    btn.setAttribute('aria-label', isLight ? 'Switch to dark mode' : 'Switch to light mode');
  }

  const buttons = document.querySelectorAll('.theme-toggle');
  buttons.forEach(syncButton);
  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
      buttons.forEach(syncButton);
    });
  });
</script>
