---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import BigCta from '../components/BigCta.astro';
import Newsletter from '../components/Newsletter.astro';
import Footer from '../components/Footer.astro';

const toolkits = [
  {
    id: 'ai-docs-playbook',
    formName: 'ai-docs-playbook',
    tag: 'Free · For individual writers',
    tagColor: 'tag-purple',
    title: 'The AI Docs Playbook',
    audience: 'Practical AI workflows for technical writers who want a more consistent documentation process.',
    desc: 'Five reusable workflows based on documentation work. They work with ChatGPT, Claude, Gemini, and other AI assistants.',
    contents: [
      'Set up an AI assistant with the right documentation context so it works based on your standards instead of making assumptions.',
      'Turn support conversations into clear, actionable documentation tasks.',
      'Draft documentation from screenshots while identifying details that still need to be verified.',
      'Run a copy edit that checks your documentation against your style guide without rewriting your voice.',
      'Create or restructure documentation pages using established documentation patterns.',
    ],
    ctaLabel: 'Get the Playbook',
    prereqs: null,
  },
  {
    id: 'ai-doc-pipeline',
    formName: 'ai-doc-pipeline',
    tag: 'Free · For senior writers & teams',
    tagColor: 'tag-teal',
    title: 'The AI Documentation Pipeline',
    audience: 'For technical writers and documentation leads working in git-based repositories who want consistent AI workflows across a team.',
    desc: 'A three-layer system that brings AI into the documentation workflow, from planning and drafting to review and release. It lives in your repository so the process stays consistent as your team grows.',
    contents: [
      'Skills layer: reusable AI workflows for research, planning, drafting, reviewing, and publishing documentation.',
      'Editor prompts: lightweight instructions for content reviews, terminology checks, and documentation audits.',
      'CI automation: automated checks with Vale prose linting and AI-generated pull request summaries.',
      'Project instruction file pattern: a way to give AI tools consistent repository-specific guidance.',
      'Setup guides for Claude Code, Cursor, and Windsurf, plus guidance for adapting the workflow to your own stack.',
    ],
    ctaLabel: 'Get the Pipeline',
    prereqs: null,
  },
  {
    id: 'translation-pipeline',
    formName: 'translation-pipeline',
    tag: 'Free · For multilingual teams',
    tagColor: 'tag-yellow',
    title: 'The AI Translation Pipeline',
    audience: 'For teams maintaining documentation in multiple languages who want a more reliable translation workflow.',
    desc: 'A structured system for translating documentation with change detection, glossary management, and human review built into the process. It helps teams automate repetitive translation work while keeping control over terminology and quality.',
    contents: [
      'Translation script with change detection: translates only the content that has changed since the last run.',
      'CI workflow: creates translation updates in a separate branch and opens a pull request for human review.',
      'Three-layer glossary system: manages terminology at the global, folder, and file levels.',
      'Review guide: helps reviewers identify common AI translation issues and check for accuracy before publishing.',
    ],
    ctaLabel: 'Get the Translation Pipeline',
    prereqs: ['Git-based doc repository', 'GitHub Actions', 'Python 3.x', 'OpenAI API key (or any translation API)'],
  },
  {
    id: 'ai-ready-docs-framework',
    formName: 'ai-ready-docs-framework',
    tag: 'Free · For docs teams & leads',
    tagColor: 'tag-neutral',
    title: 'The AI-Ready Documentation Framework',
    audience: 'For documentation leads and teams preparing their docs for AI tools, including coding agents, copilots, and RAG systems.',
    desc: 'A seven-phase framework for improving how AI tools discover, read, and use documentation. It covers benchmarking, machine-readable delivery, content structure, agent instruction files, AI-assisted workflows, maintenance, and measurement. Includes a real-world case study showing how one team improved their benchmark score from the high 50s to the mid-70s.',
    contents: [
      'The seven-phase framework: baseline benchmarking, machine-readable delivery, page structure improvements, agent instruction files, AI-assisted contribution workflows, maintenance, and measurement.',
      'How to create and automate llms.txt and llms-full.txt, with setup guidance for Docusaurus, MkDocs, Sphinx, Read the Docs, and GitBook.',
      'The reference-table pattern for converting configuration documentation from paragraphs into structured content that AI tools can extract more easily.',
      'An AGENTS.md template with guidance on writing useful instructions and deciding what belongs in the file.',
      'A companion case study showing how one team measured problems, prioritized fixes, and decided which changes were worth building.',
    ],
    ctaLabel: 'Get the Framework',
    prereqs: null,
  },
];
---

<BaseLayout
  title="Resources — Zainab Daodu"
  description="Free resources for technical writers — the AI Docs Playbook, AI Documentation Pipeline, Translation Pipeline, and AI-Ready Documentation Framework built from 8+ years of professional documentation work."
>
  <Nav />

  <header class="page-header">
    <img src="/images/ebook-cover-header.PNG" alt="" class="header-bg-img" loading="eager" aria-hidden="true" />
    <div class="header-overlay" aria-hidden="true"></div>
    <div class="container header-body">
      <p class="page-eyebrow">Resources</p>
      <h1 class="page-title">Free Resources</h1>
      <p class="page-desc">Practical tools and systems built from 8+ years of professional documentation work. Choose the resource that matches where you are right now.</p>
    </div>
  </header>

  <main class="resources-main">
    <div class="container">

      <p id="subscribe-error" class="subscribe-error" style="display: none;">
        Something went wrong submitting your email. Please try again — if it keeps happening, <a href="mailto:zainab@writetechhub.org">get in touch</a>.
      </p>

      <!-- Tier label -->
      <p class="tier-label">AI Documentation Toolkits</p>

      <!-- Row 1: Playbook + Pipeline (2-col) -->
      <div class="resources-grid">
        <article class="resource-card scroll-fade">
          <div class="card-top">
            <span class="res-tag tag-yellow">Free Ebook</span>
          </div>
          <img src="/images/ebook-cover.jpg" alt="Getting Started in Technical Writing ebook cover" class="ebook-cover" loading="lazy" />
          <h2 class="res-title">Getting Started in Technical Writing</h2>
          <p class="res-audience">For people exploring technical writing as a career or trying to get their first role.</p>
          <p class="res-desc">A practical guide to breaking into technical writing: what the role actually involves, the tools you need to know, how to build a portfolio with no work experience, and how to land your first job.</p>
          <a href="https://selar.co/3350v0" class="res-btn ebook-link" target="_blank" rel="noopener noreferrer">Get the Ebook →</a>
        </article>
        {toolkits.map((r) => (
          <article class="resource-card scroll-fade">
            <div class="card-top">
              <span class:list={['res-tag', r.tagColor]}>{r.tag}</span>
            </div>
            <h2 class="res-title">{r.title}</h2>
            <p class="res-audience">{r.audience}</p>
            <p class="res-desc">{r.desc}</p>
            <div class="res-contents">
              <h3 class="contents-label">What's inside</h3>
              <ul class="contents-list">
                {r.contents.map(item => (
                  <li>
                    <span class="item-num" aria-hidden="true">→</span>
                    <span class="item-text">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
            {r.prereqs && (
              <p class="prereq-note">Requires: {r.prereqs.join(' · ')}</p>
            )}
            <form
              name={r.formName}
              method="POST"
              action="/api/subscribe"
              class="res-form"
            >
              <input type="hidden" name="resource" value={r.formName} />
              <input type="hidden" name="bot-field" />
              <input type="text" name="name" placeholder="Your name" class="res-input" required autocomplete="name" />
              <input type="email" name="email" placeholder="your@email.com" class="res-input" required autocomplete="email" />
              <button type="submit" class="res-btn">{r.ctaLabel} →</button>
            </form>
          </article>
        ))}
      </div>


    </div>
  </main>

  <!-- From the Blog -->
  <section class="blog-section">
    <div class="container">

      <!-- Hashnode first — technical writing focus -->
      <div class="blog-platform-header">
        <div class="blog-platform-label">
          <span class="blog-eyebrow">On Hashnode</span>
          <span class="blog-platform-sub">Technical writing · Documentation standards</span>
        </div>
        <a href="https://zaycodes.hashnode.dev" class="blog-see-all" target="_blank" rel="noopener noreferrer">See all →</a>
      </div>
      <div class="blog-grid">
        {[
          {
            title: 'Research in Technical Writing: Essential Tips for Success',
            desc: 'Research is one of the most sought-after skills for technical writers. This covers how to conduct thorough research, identify reliable sources, and organise your findings for accurate, high-quality documentation.',
            date: 'October 2023',
            tag: 'Technical Writing',
            tagColor: 'btag-purple',
            cover: 'https://cdn.hashnode.com/res/hashnode/image/upload/v1696582796311/a855328c-eaee-47bf-83a2-b52f2ade5f2d.png',
            url: 'https://zaycodes.hashnode.dev/research-in-technical-writing-essential-tips-for-success',
          },
          {
            title: 'Getting Started with UX Writing',
            desc: 'UX writing shapes how users experience products. This covers the principles, techniques, and practical skills you need to write microcopy that guides users through interfaces clearly and confidently.',
            date: 'September 2023',
            tag: 'UX Writing',
            tagColor: 'btag-yellow',
            cover: 'https://cdn.hashnode.com/res/hashnode/image/upload/v1693557823084/0d178ef3-1c59-418a-ac5c-a0865e43c65d.png',
            url: 'https://zaycodes.hashnode.dev/getting-started-with-ux-writing',
          },
          {
            title: 'Style Guides in Technical Writing',
            desc: 'Style guides are one of the most important tools in a technical writer\'s toolkit. This covers what they are, why they matter, and how to use them to produce consistent, professional documentation.',
            date: 'September 2023',
            tag: 'Documentation Standards',
            tagColor: 'btag-teal',
            cover: 'https://cdn.hashnode.com/res/hashnode/image/upload/v1694772963586/98222e77-0c89-47e8-b67e-652a62ff5d47.png',
            url: 'https://zaycodes.hashnode.dev/style-guides-in-technical-writing',
          },
          {
            title: 'Search Engine Optimization in Technical Writing',
            desc: 'SEO isn\'t just for marketing — it\'s essential for documentation too. This covers how to apply SEO principles to technical content so the right readers find what they need, faster.',
            date: 'July 2023',
            tag: 'SEO',
            tagColor: 'btag-neutral',
            cover: 'https://cdn.hashnode.com/res/hashnode/image/upload/v1688974387946/eab08e97-e05e-416b-a507-360fb50e2f87.png',
            url: 'https://zaycodes.hashnode.dev/search-engine-optimization-in-technical-writing',
          },
          {
            title: 'Docs as Code: A Beginner\'s Guide',
            desc: 'Docs as Code brings software engineering practices — version control, CI/CD, and code review — to documentation workflows. This guide walks you through the tooling, philosophy, and setup from scratch.',
            date: 'May 2023',
            tag: 'Doc Ops',
            tagColor: 'btag-teal',
            cover: 'https://cdn.hashnode.com/res/hashnode/image/upload/v1684195155075/8373eb4a-afa7-4531-8010-72ffecee869a.png',
            url: 'https://zaycodes.hashnode.dev/docs-as-code-a-beginners-guide',
          },
          {
            title: 'The Role of Documentation in Software Engineering',
            desc: 'Documentation is infrastructure, not an afterthought. This explores how effective docs accelerate onboarding, reduce support load, and become a competitive advantage for engineering teams.',
            date: 'April 2023',
            tag: 'Technical Writing',
            tagColor: 'btag-purple',
            cover: 'https://cdn.hashnode.com/res/hashnode/image/upload/v1681480083833/ecebb793-461b-4d04-9e34-dc0da71cf9de.png',
            url: 'https://zaycodes.hashnode.dev/the-role-of-documentation-in-software-engineering',
          },
          {
            title: 'A Technical Writer\'s Guide to Contributing to Open Source',
            desc: 'Open source is not just for engineers. This guide shows technical writers how to find projects that need documentation help, make their first contribution, and build a portfolio through community work.',
            date: 'March 2023',
            tag: 'Open Source',
            tagColor: 'btag-teal',
            cover: 'https://cdn.hashnode.com/res/hashnode/image/upload/v1679026629859/bca554ce-8575-4940-90be-3a8a5abe5f8d.png',
            url: 'https://zaycodes.hashnode.dev/a-technical-writers-guide-to-contributing-to-open-source',
          },
          {
            title: 'Audience Analysis in Technical Writing',
            desc: 'Writing for the wrong audience is one of the most common documentation failures. This covers how to identify, research, and adapt your writing for the people who will actually use what you create.',
            date: 'February 2023',
            tag: 'Technical Writing',
            tagColor: 'btag-purple',
            cover: 'https://cdn.hashnode.com/res/hashnode/image/upload/v1677591617399/6669ff2e-2e2f-4e2c-be40-4e79e960820c.png',
            url: 'https://zaycodes.hashnode.dev/audience-analysis-in-technical-writing',
          },
        ].map(post => (
          <a href={post.url} class="blog-card" target="_blank" rel="noopener noreferrer">
            <div class="blog-cover-wrap">
              <img src={post.cover} alt={post.title} class="blog-cover" loading="lazy" />
            </div>
            <div class="blog-card-body">
              <div class="blog-card-top">
                <span class:list={['blog-tag', post.tagColor]}>{post.tag}</span>
                <span class="blog-date">{post.date}</span>
              </div>
              <h3 class="blog-title">{post.title}</h3>
              <p class="blog-desc">{post.desc}</p>
              <span class="blog-read">Read article →</span>
            </div>
          </a>
        ))}
      </div>

      <!-- Medium — developer and DevOps articles -->
      <div class="blog-platform-header" style="margin-top: 2.5rem;">
        <div class="blog-platform-label">
          <span class="blog-eyebrow">On Medium</span>
          <span class="blog-platform-sub">API documentation · DevOps · Developer tools</span>
        </div>
        <a href="https://zaycodes.medium.com" class="blog-see-all" target="_blank" rel="noopener noreferrer">See all →</a>
      </div>
      <div class="blog-grid">
        {[
          {
            title: 'How to Deploy a REST API with Edge Stack and Amazon EKS',
            desc: 'A practical guide to deploying a robust RESTful API using Ambassador Edge Stack and Amazon EKS, covering ingress configuration and routing.',
            date: 'March 2023',
            tag: 'API',
            tagColor: 'btag-purple',
            cover: 'https://miro.medium.com/v2/resize:fit:1400/format:webp/1*bz5ylKg8PPfZLDk9LT4PXg.png',
            url: 'https://zaycodes.medium.com/how-to-deploy-a-rest-api-with-ambassador-edge-stack-and-amazon-eks-11625f1ba505',
          },
          {
            title: 'Building a Collaborative and Agile Development Environment Among Teams',
            desc: 'How to build a collaborative and agile development environment with effective communication, agile methodologies, and automation.',
            date: 'July 2023',
            tag: 'DevOps',
            tagColor: 'btag-teal',
            cover: 'https://miro.medium.com/v2/resize:fit:1400/format:webp/0*jYMVQrtPKrk3og66',
            url: 'https://zaycodes.medium.com/building-a-collaborative-and-agile-development-environment-among-teams-9f7909c7e501',
          },
          {
            title: 'FAQs on Git & GitHub',
            desc: 'Answers to the most frequently asked questions about Git and GitHub for developers getting started with version control.',
            date: 'March 2023',
            tag: 'Developer Tools',
            tagColor: 'btag-yellow',
            cover: 'https://miro.medium.com/v2/resize:fit:1400/format:webp/1*xjHUFD7R3aDHN1tFXRqFYA.png',
            url: 'https://zaycodes.medium.com/faqs-on-git-github-84b21f7f8120',
          },
          {
            title: 'A Comprehensive Overview of Popular DevOps Tools and Platforms',
            desc: 'How popular DevOps tools and platforms streamline software delivery, automate processes, and improve collaboration across engineering teams.',
            date: 'July 2023',
            tag: 'DevOps',
            tagColor: 'btag-neutral',
            cover: 'https://miro.medium.com/v2/resize:fit:1400/format:webp/0*FWsBzzOLNg9sFX-2',
            url: 'https://zaycodes.medium.com/a-comprehensive-overview-of-popular-devops-tools-and-platforms-d9e1f94207d0',
          },
        ].map(post => (
          <a href={post.url} class="blog-card" target="_blank" rel="noopener noreferrer">
            <div class="blog-cover-wrap">
              <img src={post.cover} alt={post.title} class="blog-cover" loading="lazy" />
            </div>
            <div class="blog-card-body">
              <div class="blog-card-top">
                <span class:list={['blog-tag', post.tagColor]}>{post.tag}</span>
                <span class="blog-date">{post.date}</span>
              </div>
              <h3 class="blog-title">{post.title}</h3>
              <p class="blog-desc">{post.desc}</p>
              <span class="blog-read">Read article →</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <BigCta />
  <Newsletter />
  <Footer />
</BaseLayout>

<script>
  if (new URLSearchParams(window.location.search).get('subscribe_error') === '1') {
    const banner = document.getElementById('subscribe-error');
    if (banner) banner.style.display = 'block';
  }
</script>

<style>
  .page-header {
    position: relative; overflow: hidden;
    min-height: 400px;
    display: flex; align-items: flex-end;
    border-bottom: 1px solid var(--purple-22);
  }
  .header-bg-img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center 30%;
    display: block;
  }
  .header-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.75) 45%, rgba(0,0,0,0.45) 100%);
  }
  :global(html[data-theme="light"]) .header-overlay {
    background: linear-gradient(to top, rgba(242,238,248,0.95) 0%, rgba(242,238,248,0.78) 45%, rgba(242,238,248,0.4) 100%);
  }
  .header-body { position: relative; z-index: 1; padding-top: 3.5rem; padding-bottom: 3.5rem; }
  .page-eyebrow { font-family: var(--font-mono); font-size: 11px; color: var(--color-purple); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.6rem; }
  .page-desc { color: var(--white-55); font-size: 18px; line-height: 1.75; max-width: 560px; }
  .resources-main { background: var(--color-black); padding: 3.5rem 0 4rem; }

  /* Tier label */
  .tier-label { font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-purple); margin-bottom: 1.25rem; }

  /* Subscribe error banner */
  .subscribe-error { background: rgba(214,12,12,0.1); border: 1px solid rgba(214,12,12,0.3); border-radius: 6px; padding: 12px 16px; font-size: 14px; color: var(--white-55); margin-bottom: 1.5rem; }
  .subscribe-error a { color: var(--color-purple); }

  /* Row 1 — 2-column grid */
  .resources-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-bottom: 16px; }

  /* Shared card */
  .resource-card {
    background: var(--color-card); border: 1px solid var(--white-08);
    border-top: 2px solid var(--color-purple); border-radius: 8px; padding: 2rem;
    display: flex; flex-direction: column; gap: 1.1rem;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .resource-card:hover { transform: translateY(-3px); box-shadow: 0 16px 40px rgba(132,12,214,0.15); }

  /* Prerequisites note (translation pipeline) */
  .prereq-note { font-family: var(--font-mono); font-size: 10px; color: var(--color-grey); line-height: 1.6; margin-top: 0.5rem; }

  /* Tags */
  .res-tag { display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 4px 0; }
  .tag-purple { color: var(--color-purple); }
  .tag-teal { color: #15B889; }
  .tag-yellow { color: #c8c840; }
  .tag-neutral { color: var(--color-grey); }
  :global(html[data-theme="light"]) .tag-teal { color: #0B7A56; }
  :global(html[data-theme="light"]) .tag-yellow { color: #8A8A1F; }

  /* Text */
  .res-title { font-size: clamp(22px, 3vw, 28px); font-weight: 800; color: var(--color-white); letter-spacing: -0.03em; line-height: 1.1; }
  .res-audience { font-size: 13px; color: var(--color-purple); font-family: var(--font-mono); line-height: 1.5; }
  .res-desc { font-size: 15px; color: var(--white-55); line-height: 1.75; }

  /* Contents */
  .contents-label { font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-grey); margin-bottom: 0.6rem; }
  .contents-list { list-style: none; display: flex; flex-direction: column; gap: 0; }
  .contents-list li { display: flex; gap: 0.75rem; padding: 0.55rem 0; border-bottom: 1px solid var(--white-08); font-size: 14px; color: var(--white-55); line-height: 1.6; }
  .contents-list li:last-child { border-bottom: none; }
  .item-num { color: var(--color-purple); font-family: var(--font-mono); font-size: 11px; flex-shrink: 0; padding-top: 2px; }
  .item-text { flex: 1; min-width: 0; }

  /* Forms */
  .res-form { display: flex; flex-direction: column; gap: 8px; margin-top: auto; }
  .res-input { width: 100%; background: var(--white-08); border: 1px solid var(--white-22); border-radius: 3px; padding: 12px 16px; font-family: var(--font-mono); font-size: 14px; color: var(--color-white); outline: none; transition: border-color 0.2s; }
  .res-input::placeholder { color: var(--color-grey); }
  .res-input:focus { border-color: var(--color-purple); }
  .res-btn { width: 100%; background: var(--color-purple); color: #fff; font-family: var(--font-sans); font-size: 14px; font-weight: 700; padding: 12px 16px; border-radius: 3px; border: none; cursor: pointer; white-space: nowrap; transition: opacity 0.2s; }
  .res-btn:hover { opacity: 0.85; }
  /* Blog section */
  .blog-section { background: var(--color-black); padding: 3.5rem 0 4rem; border-top: 1px solid var(--purple-22); }
  .blog-platform-header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; flex-wrap: wrap; }
  .blog-platform-label { display: flex; flex-direction: column; gap: 3px; }
  .blog-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-purple); }
  .blog-platform-sub { font-size: 12px; color: var(--color-grey); font-family: var(--font-mono); }
  .blog-see-all { font-family: var(--font-mono); font-size: 12px; color: var(--color-purple); text-decoration: none; white-space: nowrap; transition: opacity 0.2s; }
  .blog-see-all:hover { opacity: 0.7; }
  .blog-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  .blog-card { background: var(--color-card); border: 1px solid var(--white-08); border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; text-decoration: none; transition: transform 0.25s, box-shadow 0.25s; }
  .blog-card:hover { transform: translateY(-3px); box-shadow: 0 14px 36px rgba(132,12,214,0.15); }
  .blog-cover-wrap { width: 100%; height: 180px; overflow: hidden; background: var(--purple-10); flex-shrink: 0; position: relative; }
  .blog-cover { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s ease; }
  .blog-card:hover .blog-cover { transform: scale(1.04); }
  .blog-card-body { padding: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem; flex: 1; }
  .blog-card-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .blog-tag { font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 0; }
  .btag-purple { color: var(--color-purple); }
  .btag-teal { color: #15B889; }
  .btag-yellow { color: #c8c840; }
  .btag-neutral { color: var(--color-grey); }
  :global(html[data-theme="light"]) .btag-teal { color: #0B7A56; }
  :global(html[data-theme="light"]) .btag-yellow { color: #8A8A1F; }
  .blog-date { font-family: var(--font-mono); font-size: 11px; color: var(--color-grey); }
