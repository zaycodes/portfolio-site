---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import CtaStrip from '../components/CtaStrip.astro';
import CtaLeadBlock from '../components/CtaLeadBlock.astro';
import MediaKit from '../components/MediaKit.astro';
import Newsletter from '../components/Newsletter.astro';
import Footer from '../components/Footer.astro';
import { toolGroups } from '../data/work';

const HEADSHOT = '/images/zainab-headshot.png';
const colorMap: Record<string, string> = {
  purple: 'tool-purple', teal: 'tool-teal', yellow: 'tool-yellow',
  mint: 'tool-mint', neutral: 'tool-neutral',
};

const WIKIMEDIA_LOGO = 'https://upload.wikimedia.org/wikipedia/commons/thumb/8/81/Wikimedia-logo.svg/120px-Wikimedia-logo.svg.png';
// Tealium's asset is a pre-made white variant meant for dark backgrounds — a white chip
// behind it would hide it, so it renders bare instead of on the usual neutral chip.
const isBareLogo = (src: string) => src.includes('tealium.svg');
// Bare logos that need a theme-swapped counterpart (the dark-mode asset
// disappears against the light theme's near-white background).
const LOGO_LIGHT_VARIANT: Record<string, string> = {
  '/images/logos/tealium.svg': '/images/logos/tealium-light.png',
};

const recIcons: Record<string, string> = {
  education: '<path d="M22 10 12 5 2 10l10 5 10-5z"/><path d="M6 12.5V17c0 1.66 2.69 3 6 3s6-1.34 6-3v-4.5"/>',
  honor: '<circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>',
  opensource: '<line x1="6" y1="3" x2="6" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 01-9 9"/>',
};

const recognitions = [
  { year: '2023', title: 'MSc Project Management — Distinction', org: 'Teesside University, Middlesbrough', type: 'education' },
  { year: '2022', title: 'OpenUK Honours List — Open Technology', org: 'OpenUK', link: 'https://openuk.uk/community/openuk-honours-lists/2022honourslist/', type: 'honor' },
  { year: '2022', title: 'Spotlight — 5 Women in Technical Writing You Should Know', org: 'The Stack Journal', link: 'https://x.com/thestackjournal/status/1564231785222995968?s=46&t=KZhBIYvkEMhZ2eZmS9i0ZVENM9pZMhJmdwYpo0Bmi3Q', type: 'honor' },
  { year: '2021', title: '10 Contributors Shaping the Future of Continuous Delivery & DevOps', org: 'Continuous Delivery Foundation', link: 'https://cd.foundation/blog/2021/02/05/celebrating-black-history-month-and-our-amazing-community/', type: 'honor' },
  { year: '2020', title: 'Google Season of Docs (GSOD) — Jenkins Project', org: 'Google', link: 'https://www.jenkins.io/sigs/docs/gsod/2020/', type: 'opensource' },
  { year: '2019', title: 'Outreachy Intern — Technical Writing', org: 'Wikimedia Foundation', link: 'https://www.outreachy.org/alums/2019-12/', type: 'opensource' },
  { year: '2015', title: 'BSc Computer Science — Second Class Upper', org: 'Al-Hikmah University, Nigeria', type: 'education' },
];

// Sunburst seal/medal motif for the Recognition section — pure decoration, no
// data. Tick marks generated rather than hand-placed so spacing stays exact.
const sealTicks = Array.from({ length: 32 }, (_, i) => {
  const angle = (i / 32) * Math.PI * 2;
  const rInner = 86, rOuter = 102;
  return {
    x1: 110 + rInner * Math.cos(angle), y1: 110 + rInner * Math.sin(angle),
    x2: 110 + rOuter * Math.cos(angle), y2: 110 + rOuter * Math.sin(angle),
  };
});

const storyPhases = [
  {
    id: 'origin',
    num: '01',
    label: 'The Origin',
    years: '2017 – 2019',
    icon: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
    paragraphs: [
      "My career started on the engineering side of the table, years before I would trade writing code for building the documentation around it.",
      "At Interswitch, Africa's leading payments company, I worked as a software engineer building payment solutions and API infrastructure. This involved payment processing, access control, security management, analytics, and the two-factor authentication that secured Interswitch's applications. The products were solid, but developers kept failing to integrate, and no amount of engineering on the backend was fixing it.",
      'I realized the gap wasn’t in the code, but in the communication around it So, I led the documentation revamp. I introduced an open-source tool to consolidate everything scattered across formats, and built a converter that turned Postman collections into structured Markdown automatically, cutting developer onboarding time by 40%. The work was more technically demanding than people expect from writing, and it was closer to the actual user than anything I had shipped as an engineer. I did not want to go back.',
    ],
    stats: [{ value: '40%', label: 'faster developer onboarding' }],
    logos: [{ name: 'Interswitch', src: '/images/logos/interswitch.png' }],
  },
  {
    id: 'pivot',
    num: '02',
    label: 'The Pivot',
    years: '2019 – 2020',
    icon: '<circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>',
    paragraphs: [
      'Open source became the next chapter.',
      'A colleague once mentioned open source. Out of curiosity, I did my research, got involved, and I started contributing to Jenkins, where thousands of developers were running it on Kubernetes with no official documentation. I helped fill that gap by writing it. I also rewrote 30+ of the most-viewed Wikimedia API pages across multiple programming languages. The Continuous Delivery Foundation named me one of the Top 10 Contributors Shaping the Future of DevOps and Continuous Delivery.',
      'When I landed my first full-time technical writing role, I was promoted to senior writer within a year. Open source had already given me depth that most entry-level hires spend years trying to build.',
    ],
    stats: [{ value: 'Top 10', label: 'DevOps & CD contributors, CD Foundation' }],
    logos: [{ name: 'Jenkins', src: '/images/logos/jenkins.svg' }, { name: 'Wikimedia Foundation', src: WIKIMEDIA_LOGO }],
  },
  {
    id: 'work',
    num: '03',
    label: 'The Work',
    years: '2020 – Present',
    icon: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/>',
    paragraphs: [
      "Since then, I have worked alongside enterprise teams to solve documentation challenges at scale. At Tealium, I focused on building the systems behind documentation, from GitHub deployment pipelines to automated style checks and a clearer site architecture. At Cisco’s ThousandEyes, I owned documentation for the v7 API launch, guiding it from Limited Preview to the platform’s default API while documenting over 300 endpoints across 20 product areas. The API now supports 88% of production API traffic.",
      "My work has also taken me across Google’s developer documentation, blockchain documentation at Rootstock and RIF, and the creation of a five-module curriculum for Magnopus’s Connected Spaces Platform.",
    ],
    stats: [
      { value: '88%', label: 'of production API traffic served' },
      { value: '300+', label: 'API endpoints documented end to end' },
      { value: '20+', label: 'product areas owned solo' },
    ],
    logos: [
      { name: 'Cisco · ThousandEyes', src: '/images/logos/thousandeyes.avif' },
      { name: 'Tealium', src: '/images/logos/tealium.svg' },
      { name: 'Google', src: '/images/logos/google.svg' },
      { name: 'IOV Labs · Rootstock', src: '/images/logos/rootstock.svg' },
      { name: 'Magnopus', src: '/images/logos/magnopus.webp' },
    ],
  },
  {
    id: 'community',
    num: '04',
    label: 'The Community',
    years: 'Ongoing',
    icon: '<path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>',
    paragraphs: [
      'As Open Source Programs Manager at She Code Africa, a pan-African non-profit supporting women in technology, I launched a global open-source bootcamp that mentored 500+ African women, paired them with international organisations, and secured over $20,000 in funding from partners including CloudBees and the Continuous Delivery Foundation.',
      'One of those mentees, Ruth Ikegah, went on to become a five-time GitHub Star and open-source board member. Seeing what that support could unlock, I continued building spaces for technical writers to grow. I founded WriteTech Hub after noticing a gap between what companies needed from technical writers and the skills many aspiring writers had access to learn. The community has since trained over 600 writers, many of whom now work at leading technology companies. The Stack Journal later named me one of the five technical writing women you should know.',
    ],
    stats: [
      { value: '600+', label: 'writers mentored globally' },
      { value: '500+', label: 'African women empowered, She Code Africa' },
    ],
    logos: [
      { name: 'She Code Africa', src: '/images/logos/she-code-africa.png' },
      { name: 'WriteTech Hub', src: '/images/logos/writetechhub.png' },
      { name: 'Jenkins', src: '/images/logos/jenkins.svg' },
    ],
  },
];
---

<BaseLayout title="About — Zainab Daodu" description="Senior Technical Writer with 8+ years of experience. Backend developer turned documentation engineer.">
  <Nav />
  <div class="about-page">

    <!-- HEADER -->
    <header class="about-header">
      <img src="/images/zainab-speaking-designday-2.jpeg" alt="" class="about-header-bg" loading="eager" aria-hidden="true" />
      <div class="about-header-overlay" aria-hidden="true"></div>
      <div class="container">
        <div class="about-header-inner">
          <div class="about-text">
            <p class="page-eyebrow">About</p>
            <h1 class="about-title">Zainab Daodu</h1>
            <p class="about-tagline">Senior Technical Writer · Backend developer turned documentation engineer</p>
            <div class="about-header-btns">
              <a href="/work" class="btn-primary">View My Work →</a>
            </div>
          </div>

          <!-- About photo -->
          <div class="about-photo-wrap">
            <div class="about-photo-frame">
              <img src={HEADSHOT} alt="Zainab Daodu" class="about-photo" loading="eager" />
            </div>
            <span class="about-zd-mono" aria-hidden="true">ZD</span>
          </div>
        </div>
      </div>
    </header>

    <CtaStrip />

    <main>
      <!-- BIO -->
      <section class="bio-section" aria-labelledby="bio-heading">
        <div class="container">
          <h2 id="bio-heading" class="section-label">The Story</h2>

          <div class="story-timeline">
            <span class="story-spine" aria-hidden="true"></span>
            {storyPhases.map((phase, i) => (
              <div class:list={['story-phase', i % 2 === 0 ? 'story-phase--left' : 'story-phase--right']}>
                <div class="story-card scroll-fade">
                  <span class="story-ghost-num" aria-hidden="true">{phase.num}</span>
                  <div class="story-phase-head">
                    <span class="story-icon-badge" aria-hidden="true">
                      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" set:html={phase.icon}></svg>
                    </span>
                    <span class="story-phase-label">{phase.label}</span>
                    <span class="story-years">{phase.years}</span>
                  </div>
                  {phase.paragraphs.map(p => <p class="story-p">{p}</p>)}
                </div>

                <div class="story-proof-card scroll-fade">
                  <div class="story-proof-stats">
                    {phase.stats.map(s => (
                      <div class="story-proof-stat">
                        <span class="story-proof-num">{s.value}</span>
                        <span class="story-proof-label">{s.label}</span>
                      </div>
                    ))}
                  </div>
                  <div class="story-proof-logos">
                    {phase.logos.map(l => (
                      LOGO_LIGHT_VARIANT[l.src] ? (
                        <>
                          <img src={l.src} alt={l.name} class="story-logo story-logo--bare theme-logo-dark-only" loading="lazy" />
                          <img src={LOGO_LIGHT_VARIANT[l.src]} alt={l.name} class="story-logo story-logo--bare theme-logo-light-only" loading="lazy" />
                        </>
                      ) : (
                        <img
                          src={l.src}
                          alt={l.name}
                          class:list={['story-logo', { 'story-logo--bare': isBareLogo(l.src) }]}
                          loading="lazy"
                        />
                      )
                    ))}
                  </div>
                </div>

                <span class="story-node" aria-hidden="true"></span>
                <span class="story-link" aria-hidden="true"></span>
              </div>
            ))}
          </div>

          <div class="bio-btns">
            <a href="/work-with-me" class="btn-primary btn-cta">
              Work With Me →
            </a>
            <MediaKit />
          </div>
        </div>
      </section>

      <!-- TOOLS -->
      <section class="tools-section" aria-labelledby="tools-heading">
        <div class="container">
          <h2 id="tools-heading" class="section-label">Tools &amp; Technology</h2>
          <div class="tools-grid stagger-children">
            {toolGroups.map(group => (
              <div class="tool-group scroll-fade">
                <h3 class="tool-group-label">{group.label}</h3>
                <div class="tool-pills">
                  {group.tools.map(tool => (
                    <span class={`tool-pill ${colorMap[group.color] || 'tool-neutral'}`}>{tool}</span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- EXPERTISE -->
      <section class="expertise-section" aria-labelledby="expertise-heading">
        <div class="container">
          <h2 id="expertise-heading" class="section-label">Areas of Expertise</h2>
          <div class="expertise-grid stagger-children">
            {[
              { icon: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>', title: 'API & Developer Documentation', desc: 'End-to-end ownership of developer documentation, from architecture decisions and OpenAPI specifications to published references and migration resources.' },
              { icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>', title: 'Product Documentation', desc: 'Strategic documentation for SaaS and developer platforms, focused on adoption, self-service, and user success.' },
              { icon: '<path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/>', title: 'UX Writing', desc: 'Content design that connects product decisions with user needs through clear, consistent experiences.' },
              { icon: '<polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>', title: 'Documentation Operations', desc: 'The processes and tooling that make documentation sustainable, including automation, CI/CD, and docs-as-code workflows.' },
            ].map(ex => (
              <div class="expertise-card scroll-fade">
                <div class="ex-icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" set:html={ex.icon}></svg>
                </div>
                <h3>{ex.title}</h3>
                <p>{ex.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- RECOGNITION -->
      <section class="recognition-section" aria-labelledby="recognition-heading">
        <div class="container">
          <h2 id="recognition-heading" class="section-label">Education &amp; Recognition</h2>
          <div class="recognition-body">
            <div class="recognition-list stagger-children">
              {recognitions.map(r => (
                <div class="recognition-item scroll-fade">
                  <span class="rec-year">{r.year}</span>
                  <div class="rec-icon" aria-hidden="true">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" set:html={recIcons[r.type]}></svg>
                  </div>
                  <div class="rec-main">
                    {r.link ? (
                      <a href={r.link} class="rec-title rec-link" target="_blank" rel="noopener noreferrer">{r.title}</a>
                    ) : (
                      <p class="rec-title">{r.title}</p>
                    )}
                    <p class="rec-org">{r.org}</p>
                  </div>
                </div>
              ))}
            </div>

            <aside class="rec-summary scroll-fade" aria-hidden="true">
              <svg width="220" height="220" viewBox="0 0 220 220" class="rec-seal">
                <circle cx="110" cy="110" r="84" fill="none" stroke="rgba(132,12,214,0.2)" stroke-width="1" />
                <circle cx="110" cy="110" r="60" fill="none" stroke="rgba(132,12,214,0.13)" stroke-width="1" />
                {sealTicks.map(t => (
                  <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} stroke="rgba(132,12,214,0.3)" stroke-width="1.5" stroke-linecap="round" />
                ))}
                <text x="110" y="121" text-anchor="middle" font-family="var(--font-mono)" font-size="32" font-weight="800" letter-spacing="-1" class="rec-seal-mark">ZD</text>
              </svg>
            </aside>
          </div>
        </div>
      </section>

    </main>
  </div>

  <CtaLeadBlock />
  <Newsletter />
  <Footer />
</BaseLayout>

<style>
  .about-page { background: var(--color-black); min-height: 100vh; }
  .about-header {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--purple-22);
    padding: 3.5rem 0;
  }
  .about-header-bg {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; object-position: center 20%;
    display: block;
    opacity: 0.18;
  }
  .about-header-overlay {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse at 70% 50%, rgba(132,12,214,0.2) 0%, transparent 60%),
      linear-gradient(to bottom, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.8) 100%);
  }
  /* The dark scrim exists so light headline text stays legible over the
     photo. In light mode the headline flips to dark ink, so the scrim
     flips to a light wash (tinted to the light theme's page background)
     instead — otherwise dark text would sit on a dark island. */
  :global(html[data-theme="light"]) .about-header-overlay {
    background:
      radial-gradient(ellipse at 70% 50%, rgba(132,12,214,0.12) 0%, transparent 60%),
      linear-gradient(to bottom, rgba(242,238,248,0.65) 0%, rgba(242,238,248,0.92) 100%);
  }
  .about-header .container { position: relative; z-index: 1; }
  .about-header-inner { display: flex; align-items: center; justify-content: space-between; gap: 3rem; flex-wrap: wrap; }
  .about-text { flex: 1; min-width: 260px; }
  .page-eyebrow { font-family: var(--font-mono); font-size: 12px; color: var(--color-purple); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.6rem; }
  .about-title { font-size: clamp(36px, 6vw, 58px); font-weight: 800; color: var(--color-white); letter-spacing: -0.03em; line-height: 1.05; margin-bottom: 0.65rem; }
  .about-tagline { color: var(--white-55); font-size: 16px; font-family: var(--font-mono); margin-bottom: 1.75rem; }
  .about-header-btns { display: flex; gap: 12px; flex-wrap: wrap; }

  /* About photo */
  .about-photo-wrap { flex-shrink: 0; position: relative; }
  .about-photo-frame { position: relative; width: 320px; z-index: 1; }
  .about-photo-frame::before {
    content: '';
    position: absolute;
    width: 300px; height: 300px;
    border-radius: 50%;
    border: 1px solid rgba(132,12,214,0.2);
    background: radial-gradient(circle, rgba(132,12,214,0.07) 0%, transparent 70%);
    top: 50%; left: 50%;
    transform: translate(-50%, -48%);
    z-index: 0;
    pointer-events: none;
  }
  .about-zd-mono {
    position: absolute;
    bottom: -16px; right: -24px;
    font-size: 100px; font-weight: 900;
    color: rgba(132,12,214,0.06);
    letter-spacing: -0.06em; line-height: 1;
    z-index: 0; user-select: none; pointer-events: none;
  }
  .about-photo {
    width: 100%; display: block; position: relative; z-index: 1;
    filter: drop-shadow(0 20px 48px rgba(132,12,214,0.22)) drop-shadow(0 8px 24px rgba(0,0,0,0.6));
    mask-image: linear-gradient(to bottom, black 72%, transparent 100%);
    -webkit-mask-image: linear-gradient(to bottom, black 72%, transparent 100%);
  }

  /* Every section shares one true-black background — sections are told apart by
     borders, spacing, and content design, not by shifting between near-black hues */
  .bio-section, .tools-section, .expertise-section, .recognition-section, .media-kit-section { padding: 4rem 0; }
  .bio-section, .tools-section, .expertise-section, .recognition-section {
    background: var(--color-black);
    border-bottom: 1px solid var(--white-08);
    position: relative;
  }
  .bio-section, .tools-section, .expertise-section { overflow: hidden; }
  /* No overflow:hidden here — .rec-summary below uses position:sticky, and an
     overflow:hidden ancestor breaks sticky positioning */
  .recognition-section { border-bottom: none; }
  /* Decorative shapes below are absolutely positioned, which (with z-index:auto)
     paint above static in-flow content by default — lift the actual content
     above them explicitly */
  .tools-section .container, .expertise-section .container, .recognition-section .container {
    position: relative;
    z-index: 1;
  }
  .section-label { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-purple); margin-bottom: 1.75rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--purple-22); }

  /* ── Section decoration — each gets its own distinct shape language rather than
     one pattern repeated down the page. The Story section already has plenty of
     visual interest from the timeline itself, so it's left alone. ── */

  /* Tools & Technology — a single soft glow, fits a dense, practical pill grid */
  .tools-section::before {
    content: '';
    position: absolute;
    bottom: -140px; right: -80px;
    width: 360px; height: 360px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(132,12,214,0.18) 0%, transparent 70%);
    pointer-events: none;
  }

  /* Areas of Expertise — geometric outlines, framing the card grid with structure */
  .expertise-section::before {
    content: '';
    position: absolute;
    top: -70px; left: -70px;
    width: 220px; height: 220px;
    border-radius: 50%;
    border: 1px solid rgba(132,12,214,0.2);
    pointer-events: none;
  }
  .expertise-section::after {
    content: '';
    position: absolute;
    width: 26px; height: 26px;
    border: 1.5px solid rgba(132,12,214,0.28);
    transform: rotate(45deg);
    bottom: 18%; right: 6%;
    pointer-events: none;
  }

  /* Education & Recognition — kept quiet on purpose; this list reads as a record,
     not a feature, so it gets only a faint glow rather than a busy pattern */
  .recognition-section::before {
    content: '';
    position: absolute;
    top: -120px; right: -100px;
    width: 320px; height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(132,12,214,0.1) 0%, transparent 70%);
    pointer-events: none;
  }

  /* Story — two-up timeline on a pure black canvas: narrative card on one side,
     a metrics + logos "proof" card on the other, alternating per phase. Both sides
     always carry real content, so there's no dead space to dress up with filler. */
  .story-timeline { position: relative; padding: 0.5rem 0; }

  .story-spine {
    position: absolute;
    left: 50%; top: 0; bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom, transparent, rgba(132,12,214,0.3) 6%, rgba(132,12,214,0.3) 94%, transparent);
    transform: translateX(-50%);
  }

  /* Not a grid — grid's align-items:center centers on whichever box is taller,
     which flips depending on how much text vs. stats each phase has. The proof
     card and connector are taken out of flow entirely and pinned to 50% of
     .story-phase's height, which (since the story card is the only thing left
     in flow) always equals the story card's own height. That's what keeps the
     node centered on the story specifically, on every phase, regardless of content. */
  .story-phase {
    position: relative;
    margin-bottom: 2.5rem;
  }
  .story-phase:last-child { margin-bottom: 0; }

  .story-card { width: calc(50% - 1.625rem); }
  .story-phase--left .story-card  { margin-right: auto; }
  .story-phase--right .story-card { margin-left: auto; }

  .story-proof-card {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: calc(50% - 1.625rem);
